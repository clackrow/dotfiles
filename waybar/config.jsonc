{
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,

    "modules-left": [
        "sway/workspaces"
    ],

    "modules-center": [
        "custom/launcher",
        "clock"
    ],

    "modules-right": [
        "custom/screenshot",
        "backlight",
        "pulseaudio",
        "bluetooth",
        "battery",
        "tray"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "custom/launcher": {
        "tooltip": false,
        "format": "󱄅",
        "on-click": "wofi --show drun"
    },

    "custom/screenshot": {
        "tooltip": false,
        "format": "󰹑",
        "on-click": "grim -g \"$(slurp)\" - | wl-copy"
    },

    "backlight": {
        "format": "{icon}",
        "format-icons": [
            "󰃞",
            "󰃝",
            "󰃟",
            "󰃠",
            "󰃚"
        ]
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "",
        "format-bluetooth": "{icon}",
        "format-icons": {
            "headphone": "",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol"
    },

    "bluetooth": {
        "format-on": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂯",
        "format-connected-battery": "{device_battery_percentage}% 󰂯",
        "tooltip-format": "{num_connections} connected"
    },

    "clock": {
        "format": "{:%d/%m | %H:%M}",
        "interval": 1,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "format": {
                "today": "<span><b>{}</b></span>"
            }
        },
        "on-click": "foot -e calcurse"
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "foot -e nmtui"
    },

    "battery": {
        "interval": 30,
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-plugged": "{capacity}% 󰂄",
        "format-alt": "{time} {icon}",
        "format-icons": [
            "󰁻",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰂂",
            "󰁹"
        ]
    },

    "tray": {
        "icon-size": 14,
        "spacing": 10
    }
}

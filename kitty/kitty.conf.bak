# font_family      caskaydia
# bold_font        auto
# italic_font      auto
# bold_italic_font auto
font_size 15

window_padding_width 0
background_opacity 1


# BEGIN_KITTY_THEME
# Dracula
include current-theme.conf
# END_KITTY_THEME

# BEGIN_KITTY_FONTS
font_family      family="Adwaita Mono"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS